# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=8080

MONGODB_URI=mongodb://127.0.0.1:27017/dialogue-room

# Frontend origin (CORS + links in emails)
CLIENT_URL=http://localhost:3000

# Generate long random strings (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (dev: any SMTP sandbox e.g. Mailtrap; leave EMAIL_HOST empty to log emails to console)
EMAIL_HOST=
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="Dialogue Room <no-reply@dialogueroom.local>"
